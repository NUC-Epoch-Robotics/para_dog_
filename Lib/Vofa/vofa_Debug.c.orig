#include "stdlib.h"
#include <stdint.h>
#include "vofa_Debug.h"
extern float vofa_data;
union
{
        uint8_t b[4];
        float f;
      } conv;
float vofa_GetData(uint8_t *data)
{
  static float num = 0.0f;

  if (data == NULL)
    {
      return num;
    }
  // Frame format: 0x5A + 4-byte float payload + '\n' (0x0A).
  if ((data[0] == 0x5A) && (data[5] == 0x0A))
    {
      union
      {
        uint8_t b[4];
        float f;
      } conv;

      // VOFA JustFloat payload is little-endian on STM32.
      conv.b[0] = data[1];
      conv.b[1] = data[2];
      conv.b[2] = data[3];
      conv.b[3] = data[4];

      num = conv.f;
      vofa_data = num;
    }
  return num;
}















